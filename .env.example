# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3456
NEXTAUTH_SECRET=

# Password to log in to the Linki UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./linki.db in cwd)
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging)
HEADLESS=true

# Authenticated MCP endpoint at /api/mcp
# Generate the bearer token with: openssl rand -hex 32
MCP_API_TOKEN=

# Review-only MCP staging queue. Copy these IDs from Linki after creating the
# LinkedIn account (actual connection limit 1..25), single blank-connect workflow,
# exactly one paused run, and LinkedIn-purpose list in the UI.
MCP_ACCOUNT_ID=
MCP_WORKFLOW_ID=
MCP_LIST_ID=

# Keep false until the IDs above are reviewed. Even when true, MCP can only add
# prospects to the configured paused run; it cannot launch or send outreach.
MCP_WRITES_ENABLED=false
